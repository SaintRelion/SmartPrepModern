<UserControl
    x:Class="Components.RevieweeSelectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Border
        Background="White"
        BorderBrush="#DDD"
        BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="16" Background="#F9F9F9">
                <StackPanel>
                    <TextBlock
                        FontSize="11"
                        FontWeight="Black"
                        Opacity="0.6"
                        Text="SELECT REVIEWEE" />
                    <TextBlock
                        x:Name="txtContext"
                        Margin="0,4,0,0"
                        FontSize="10"
                        Foreground="#2196F3"
                        Text="Global Overview" />
                </StackPanel>
            </Border>

            <ListBox
                x:Name="lstReviewees"
                Grid.Row="1"
                Background="Transparent"
                BorderThickness="0"
                SelectionChanged="lstReviewees_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            x:Name="brdStatus"
                            Padding="12"
                            BorderThickness="4,0,0,1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#FF5252" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding has_taken}" Value="True">
                                            <Setter Property="BorderBrush" Value="#4CAF50" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    VerticalAlignment="Center"
                                    Kind="AccountCircle"
                                    Opacity="0.5" />
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock FontWeight="Bold" Text="{Binding username}" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="Gray"
                                        Text="{Binding email}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border
                x:Name="pnlLoading"
                Background="White"
                Opacity="0.7"
                Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <ProgressBar
                        Width="30"
                        Height="30"
                        IsIndeterminate="True"
                        Style="{StaticResource MaterialDesignCircularProgressBar}" />
                    <TextBlock
                        Margin="0,10"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        FontWeight="Black"
                        Opacity="0.5"
                        Text="LOADING REVIEWEES..." />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
