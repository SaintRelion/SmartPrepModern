<UserControl
    x:Class="Views.Reviewee.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:SmartPrepModern.Components"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Background="{DynamicResource MaterialDesignPaper}">

    <Grid>
        <Grid x:Name="pnlDashboardLayout">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="#F8F8F8"
                BorderBrush="#DDD"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="#1A1A1A">
                        <TextBlock
                            Margin="12,16"
                            FontSize="11"
                            FontWeight="Black"
                            Foreground="White"
                            Text="MY EXAMINATION HISTORY" />
                    </Border>

                    <StackPanel Grid.Row="1" Background="#EEE">
                        <ComboBox
                            x:Name="cmbSearchDiff"
                            Background="White"
                            BorderThickness="0"
                            SelectionChanged="FilterExams_Local">
                            <ComboBox.Padding>12,12</ComboBox.Padding>
                            <ComboBoxItem Content="All Difficulties" IsSelected="True" />
                            <ComboBoxItem Content="Easy" />
                            <ComboBoxItem Content="Medium" />
                            <ComboBoxItem Content="Hard" />
                        </ComboBox>

                        <ComboBox
                            x:Name="cmbFocusType"
                            Background="White"
                            BorderThickness="0,1,0,0"
                            SelectionChanged="FilterExams_Local">
                            <ComboBox.Padding>12,12</ComboBox.Padding>
                            <ComboBoxItem Content="All Types" IsSelected="True" />
                            <ComboBoxItem Content="Comprehensive" />
                            <ComboBoxItem Content="Weak Areas" />
                        </ComboBox>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="lstExams">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Background="#E0E0E0">
                                            <TextBlock
                                                Margin="12,4"
                                                FontSize="10"
                                                FontWeight="Black"
                                                Opacity="0.8"
                                                Text="{Binding exam_date}" />
                                        </Border>
                                        <ListBox
                                            HorizontalContentAlignment="Stretch"
                                            BorderThickness="0"
                                            ItemsSource="{Binding exams}"
                                            SelectionChanged="ExamSelection_Changed">
                                            <ListBox.ItemContainerStyle>
                                                <Style BasedOn="{StaticResource MaterialDesignListBoxItem}" TargetType="ListBoxItem">
                                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                    <Setter Property="BorderBrush" Value="#DDD" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#1A1A1A" />
                                                            <Setter Property="Foreground" Value="White" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="12">
                                                        <Grid>
                                                            <StackPanel>
                                                                <TextBlock
                                                                    FontSize="13"
                                                                    FontWeight="Bold"
                                                                    Text="{Binding focus}" />
                                                                <TextBlock
                                                                    Margin="0,2,0,0"
                                                                    FontSize="10"
                                                                    Opacity="0.5"
                                                                    Text="{Binding difficulty}" />
                                                            </StackPanel>
                                                            <TextBlock
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                FontSize="10"
                                                                Opacity="0.5"
                                                                Text="{Binding created_at}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <components:UniversalStatsView x:Name="ctrlAnalytics" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
