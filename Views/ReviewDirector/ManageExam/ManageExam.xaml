<UserControl
    x:Class="Views.ReviewDirector.ManageExamView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:SmartPrepModern.Components"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Background="#F5F7FA">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <components:ExamSelectorView x:Name="examSelector" Grid.Column="0" />

        <Border
            Grid.Column="1"
            Margin="20"
            Padding="30"
            Background="Transparent">
            <StackPanel x:Name="pnlDetails" Visibility="Collapsed">

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        x:Name="txtExamTitle"
                        VerticalAlignment="Center"
                        FontSize="24"
                        FontWeight="Black" />
                    <Button
                        Width="30"
                        Height="30"
                        Margin="10,0,0,0"
                        Padding="4"
                        Click="btnRename_Click"
                        Style="{StaticResource MaterialDesignFlatButton}">
                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Kind="Pencil"
                            Opacity="0.5" />
                    </Button>
                </StackPanel>

                <TextBlock
                    x:Name="txtExamMeta"
                    Margin="0,5,0,20"
                    Opacity="0.5" />

                <Grid Margin="0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        Padding="20">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="10"
                                FontWeight="Black"
                                Opacity="0.5"
                                Text="TOTAL ITEMS" />
                            <TextBlock
                                x:Name="txtItemCount"
                                HorizontalAlignment="Center"
                                FontSize="32"
                                FontWeight="Black"
                                Text="0" />
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Padding="20">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="10"
                                FontWeight="Black"
                                Opacity="0.5"
                                Text="ACTIVE RECORD" />
                            <TextBlock
                                x:Name="txtStudentCount"
                                HorizontalAlignment="Center"
                                FontSize="32"
                                FontWeight="Black"
                                Text="0" />
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>

                <StackPanel Margin="0,40,0,0" Orientation="Horizontal">
                    <Button
                        Width="200"
                        Height="45"
                        Click="btnPreview_Click"
                        Content="PREVIEW QUESTIONS"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}" />
                    <Button
                        Margin="20,0,0,0"
                        BorderBrush="Red"
                        Click="btnDelete_Click"
                        Content="DELETE EXAM"
                        Foreground="Red"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
