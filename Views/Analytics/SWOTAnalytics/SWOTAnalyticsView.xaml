<UserControl
    x:Class="Views.Analytics.SWOTAnalyticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Background="#F5F5F5">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <materialDesign:Card
            Grid.Row="0"
            Margin="0,0,0,24"
            Padding="20"
            Background="#1A1A1A">
            <Grid>
                <StackPanel>
                    <TextBlock
                        FontSize="10"
                        FontWeight="Black"
                        Foreground="Gray"
                        Text="CLASS SWOT ANALYTICS" />
                    <TextBlock
                        FontSize="24"
                        FontWeight="Black"
                        Foreground="White"
                        Text="INTELLIGENCE DOSSIERS" />
                </StackPanel>
                <Button
                    HorizontalAlignment="Right"
                    Click="Refresh_Click"
                    Content="REFRESH ANALYTICS"
                    Foreground="White"
                    Style="{StaticResource MaterialDesignFlatButton}" />
            </Grid>
        </materialDesign:Card>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="lstDossiers">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card
                            Margin="0,0,8,16"
                            Padding="24"
                            Background="White">
                            <StackPanel>
                                <Grid Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="18"
                                            FontWeight="Black"
                                            Foreground="#333"
                                            Text="{Binding Username}" />
                                        <TextBlock
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Opacity="0.5"
                                            Text="ACTIVE REVIEWEE PROFILE" />
                                    </StackPanel>
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="22"
                                        FontWeight="Black"
                                        Foreground="#2196F3"
                                        Text="{Binding OverallAvg, StringFormat={}{0:F1}%}" />
                                </Grid>

                                <TextBlock
                                    Margin="0,0,0,10"
                                    FontSize="9"
                                    FontWeight="Black"
                                    Opacity="0.4"
                                    Text="SUBJECT PERFORMANCE ARCHIVE" />
                                <ItemsControl ItemsSource="{Binding SubjectProgress}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="45" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Text="{Binding label}"
                                                    TextTrimming="CharacterEllipsis" />

                                                <ProgressBar
                                                    Grid.Column="1"
                                                    Height="12"
                                                    Margin="15,0"
                                                    VerticalAlignment="Center"
                                                    Background="#F0F0F0"
                                                    BorderThickness="0"
                                                    Foreground="#4CAF50"
                                                    Value="{Binding percentage}" />

                                                <TextBlock
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="Black"
                                                    Text="{Binding percentage, StringFormat={}{0:F0}%}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Separator Margin="0,20" Opacity="0.1" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock
                                            Margin="0,0,0,8"
                                            FontSize="9"
                                            FontWeight="Black"
                                            Foreground="Green"
                                            Text="PRIMARY STRENGTHS" />
                                        <ItemsControl ItemsSource="{Binding Strengths}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Margin="0,0,0,4"
                                                        Padding="8,4"
                                                        HorizontalAlignment="Left"
                                                        Background="#E8F5E9"
                                                        CornerRadius="4">
                                                        <TextBlock
                                                            FontSize="11"
                                                            FontWeight="Bold"
                                                            Foreground="Green"
                                                            Text="{Binding label}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock
                                            Margin="0,0,0,8"
                                            FontSize="9"
                                            FontWeight="Black"
                                            Foreground="#B71C1C"
                                            Text="CRITICAL WEAKNESSES" />
                                        <ItemsControl ItemsSource="{Binding Weaknesses}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Margin="0,0,0,4"
                                                        Padding="8,4"
                                                        HorizontalAlignment="Left"
                                                        Background="#FFEBEE"
                                                        CornerRadius="4">
                                                        <TextBlock
                                                            FontSize="11"
                                                            FontWeight="Bold"
                                                            Foreground="#B71C1C"
                                                            Text="{Binding label}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
