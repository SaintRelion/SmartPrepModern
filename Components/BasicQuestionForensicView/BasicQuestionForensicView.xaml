<UserControl
    x:Class="Components.BasicQuestionForensicView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Border Background="#F8F9FA" CornerRadius="12">
        <Grid>
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock
                            x:Name="txtTitle"
                            FontSize="20"
                            FontWeight="Black"
                            Text="BASIC SCORECARD" />
                        <TextBlock
                            x:Name="txtSubtitle"
                            FontSize="12"
                            Opacity="0.5"
                            Text="Select a topic to view question progression." />
                    </StackPanel>
                    <Button
                        HorizontalAlignment="Right"
                        Click="Close_Click"
                        Style="{StaticResource MaterialDesignIconButton}">
                        <materialDesign:PackIcon
                            Width="24"
                            Height="24"
                            Kind="Close" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="colRevieweeStrip" Width="0" />
                        <!--  expands when batch  -->
                        <ColumnDefinition Width="280" />
                        <!--  topics (was col 0)  -->
                        <ColumnDefinition Width="*" />
                        <!--  questions (was col 1)  -->
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="pnlRevieweeStrip"
                        Grid.Column="0"
                        Margin="0,0,16,0"
                        Padding="8"
                        Background="White"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="10"
                                Opacity="0.05"
                                ShadowDepth="2" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Margin="8,8,0,12"
                                FontSize="11"
                                FontWeight="Black"
                                Opacity="0.5"
                                Text="REVIEWEES" />
                            <ListBox
                                x:Name="lstReviewees"
                                Grid.Row="1"
                                BorderThickness="0"
                                DisplayMemberPath="username"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectionChanged="Reviewee_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,8" />
                                        <Setter Property="Margin" Value="0,0,0,4" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Cursor" Value="Hand" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Margin="0,0,24,0"
                        Padding="8"
                        Background="White"
                        CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="10"
                                Opacity="0.05"
                                ShadowDepth="2" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Margin="8,8,0,12"
                                FontSize="11"
                                FontWeight="Black"
                                Opacity="0.5"
                                Text="FILTER BY TOPIC" />

                            <ListBox
                                x:Name="lstTopics"
                                Grid.Row="1"
                                BorderThickness="0"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectionChanged="Topic_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border
                                                        x:Name="bd"
                                                        Padding="16,12"
                                                        Background="#F1F3F5"
                                                        CornerRadius="6"
                                                        Cursor="Hand">
                                                        <TextBlock
                                                            x:Name="txt"
                                                            FontSize="13"
                                                            FontWeight="Bold"
                                                            Foreground="#333"
                                                            Text="{Binding}"
                                                            TextWrapping="Wrap" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#E9ECEF" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#1976D2" />
                                                            <Setter TargetName="txt" Property="Foreground" Value="White" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="Gray"
                                    Kind="FilterVariant" />
                                <ComboBox
                                    x:Name="cmbStatusFilter"
                                    Width="160"
                                    materialDesign:HintAssist.Hint="Status Filter"
                                    SelectionChanged="Status_SelectionChanged"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                    <ComboBoxItem Content="ALL QUESTIONS" IsSelected="True" />
                                    <ComboBoxItem Content="CORRECT ONLY" />
                                    <ComboBoxItem Content="INCORRECT ONLY" />
                                </ComboBox>
                            </StackPanel>

                            <TextBlock
                                x:Name="txtItemCount"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="Bold"
                                Opacity="0.6"
                                Text="0 Items" />
                        </Grid>

                        <ListBox
                            x:Name="lstBasicQuestions"
                            Grid.Row="1"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        x:Name="mainBorder"
                                        Margin="0,0,12,16"
                                        Padding="20"
                                        Background="White"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="4,1,1,1"
                                        CornerRadius="8">
                                        <Border.Effect>
                                            <DropShadowEffect
                                                BlurRadius="8"
                                                Opacity="0.05"
                                                ShadowDepth="1" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Foreground="#1976D2"
                                                    Text="{Binding slot_name}" />
                                                <Border
                                                    x:Name="bdgStatus"
                                                    Padding="10,4"
                                                    HorizontalAlignment="Right"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        x:Name="txtStatus"
                                                        FontSize="10"
                                                        FontWeight="Black" />
                                                </Border>
                                            </Grid>

                                            <TextBlock
                                                Margin="0,0,0,16"
                                                FontSize="14"
                                                FontWeight="Medium"
                                                Opacity="0.9"
                                                Text="{Binding question_text}"
                                                TextWrapping="Wrap" />

                                            <Border
                                                x:Name="pillCurrent"
                                                Padding="12,10"
                                                HorizontalAlignment="Left"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <StackPanel>
                                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                                                        <StackPanel
                                                            x:Name="pnlPrevious"
                                                            Margin="0,0,12,0"
                                                            VerticalAlignment="Top">
                                                            <TextBlock
                                                                Margin="0,0,0,4"
                                                                FontSize="9"
                                                                FontWeight="Black"
                                                                Opacity="0.5"
                                                                Text="PREVIOUS ANSWER" />
                                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                                <TextBlock
                                                                    Width="220"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="12"
                                                                    Opacity="0.6"
                                                                    Text="{Binding previous_student_answer}"
                                                                    TextDecorations="Strikethrough"
                                                                    TextWrapping="Wrap" />

                                                                <materialDesign:PackIcon
                                                                    Width="16"
                                                                    Height="16"
                                                                    Margin="12,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Kind="ArrowRightThick"
                                                                    Opacity="0.3" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel VerticalAlignment="Top">
                                                            <TextBlock
                                                                Margin="0,0,0,4"
                                                                FontSize="9"
                                                                FontWeight="Black"
                                                                Opacity="0.5"
                                                                Text="LATEST ANSWER" />
                                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                                <materialDesign:PackIcon
                                                                    x:Name="iconCurrent"
                                                                    Width="16"
                                                                    Height="16"
                                                                    Margin="0,0,6,0"
                                                                    VerticalAlignment="Center" />
                                                                <TextBlock
                                                                    Width="250"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="13"
                                                                    FontWeight="Bold"
                                                                    Text="{Binding student_answer}"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding previous_student_answer}" Value="">
                                            <Setter TargetName="pnlPrevious" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding previous_student_answer}" Value="{x:Null}">
                                            <Setter TargetName="pnlPrevious" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding is_correct}" Value="True">
                                            <Setter TargetName="mainBorder" Property="BorderBrush" Value="#4CAF50" />
                                            <Setter TargetName="bdgStatus" Property="Background" Value="#E8F5E9" />
                                            <Setter TargetName="txtStatus" Property="Text" Value="CORRECT" />
                                            <Setter TargetName="txtStatus" Property="Foreground" Value="#2E7D32" />
                                            <Setter TargetName="pillCurrent" Property="Background" Value="#E8F5E9" />
                                            <Setter TargetName="pillCurrent" Property="BorderBrush" Value="#A5D6A7" />
                                            <Setter TargetName="iconCurrent" Property="Kind" Value="CheckCircle" />
                                            <Setter TargetName="iconCurrent" Property="Foreground" Value="#2E7D32" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding is_correct}" Value="False">
                                            <Setter TargetName="mainBorder" Property="BorderBrush" Value="#F44336" />
                                            <Setter TargetName="bdgStatus" Property="Background" Value="#FFEBEE" />
                                            <Setter TargetName="txtStatus" Property="Text" Value="INCORRECT" />
                                            <Setter TargetName="txtStatus" Property="Foreground" Value="#C62828" />
                                            <Setter TargetName="pillCurrent" Property="Background" Value="#FFEBEE" />
                                            <Setter TargetName="pillCurrent" Property="BorderBrush" Value="#EF9A9A" />
                                            <Setter TargetName="iconCurrent" Property="Kind" Value="CloseCircle" />
                                            <Setter TargetName="iconCurrent" Property="Foreground" Value="#C62828" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Grid>

            <!--  Loading overlay sits on top, same wrapper grid, no row/col needed  -->
            <Border
                x:Name="pnlLoadingOverlay"
                Panel.ZIndex="10"
                Background="White"
                CornerRadius="12"
                Opacity="0.85"
                Visibility="Collapsed">
                <ProgressBar
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsIndeterminate="True"
                    Style="{StaticResource MaterialDesignCircularProgressBar}" />
            </Border>
        </Grid>
    </Border>
</UserControl>
