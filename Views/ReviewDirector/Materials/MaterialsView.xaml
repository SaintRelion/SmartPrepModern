<UserControl
        x:Class="Views.ReviewDirector.MaterialsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{DynamicResource MaterialDesignPaper}">

        <UserControl.Resources>
                <SolidColorBrush x:Key="CriminologyRed" Color="#B71C1C" />
        </UserControl.Resources>

        <Grid Margin="24">
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="450" />
                        <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <materialDesign:Card Padding="24" materialDesign:ElevationAssist.Elevation="Dp2">
                                <StackPanel>
                                        <StackPanel Margin="0,0,0,20">
                                                <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon
                                                                Width="28"
                                                                Height="28"
                                                                Foreground="{StaticResource CriminologyRed}"
                                                                Kind="CloudUpload" />
                                                        <TextBlock
                                                                Margin="10,0,0,0"
                                                                FontSize="20"
                                                                FontWeight="Black"
                                                                Foreground="{StaticResource CriminologyRed}"
                                                                Text="NEW MATERIAL" />
                                                </StackPanel>
                                                <TextBlock
                                                        FontSize="12"
                                                        Opacity="0.6"
                                                        Text="Upload PDF modules for AI indexing." />
                                        </StackPanel>

                                        <TextBox
                                                x:Name="txtFilePath"
                                                materialDesign:HintAssist.Hint="Document Path"
                                                IsReadOnly="True"
                                                Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                                        <Button
                                                x:Name="btnBrowse"
                                                Margin="0,12,0,20"
                                                Click="BrowseFile_Click"
                                                Content="BROWSE FILE"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                                        <CheckBox
                                                x:Name="chkUseOllama"
                                                Margin="0,0,0,20"
                                                Content="Use Ollama"
                                                IsChecked="True" />
                                        <Button
                                                x:Name="btnUpload"
                                                Height="45"
                                                Background="{StaticResource CriminologyRed}"
                                                Click="UploadFile_Click"
                                                Content="INDUCT MATERIAL" />

                                        <StackPanel
                                                x:Name="pnlProgress"
                                                Margin="0,20,0,0"
                                                Visibility="Collapsed">
                                                <ProgressBar Foreground="{StaticResource CriminologyRed}" IsIndeterminate="True" />
                                                <TextBlock
                                                        x:Name="lblStatus"
                                                        Margin="0,8,0,0"
                                                        HorizontalAlignment="Center"
                                                        FontSize="12"
                                                        Text="Processing..." />
                                        </StackPanel>
                                </StackPanel>
                        </materialDesign:Card>

                        <GroupBox
                                Margin="0,20,0,0"
                                Header="TRANSMISSION LOG"
                                Style="{StaticResource MaterialDesignCardGroupBox}">
                                <ListBox
                                        x:Name="lstLog"
                                        Height="200"
                                        FontFamily="Consolas"
                                        FontSize="11" />
                        </GroupBox>
                </StackPanel>

                <materialDesign:Card Grid.Column="1" materialDesign:ElevationAssist.Elevation="Dp2">
                        <Grid>
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Background="{StaticResource CriminologyRed}" Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                                VerticalAlignment="Center"
                                                Foreground="White"
                                                Kind="Database" />
                                        <TextBlock
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="INTELLIGENCE DATABASE" />
                                </StackPanel>

                                <DataGrid
                                        x:Name="dgMaterials"
                                        Grid.Row="1"
                                        AutoGenerateColumns="False"
                                        HeadersVisibility="Column"
                                        IsReadOnly="True">
                                        <DataGrid.Columns>
                                                <DataGridTextColumn
                                                        Width="*"
                                                        Binding="{Binding title_content}"
                                                        FontWeight="Bold"
                                                        Header="TITLE" />

                                                <DataGridTemplateColumn Width="150" Header="STATUS">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                        <StackPanel x:Name="StatusContainer" Orientation="Horizontal">
                                                                                <materialDesign:PackIcon
                                                                                        x:Name="StatusIcon"
                                                                                        VerticalAlignment="Center"
                                                                                        Kind="ClockOutline"
                                                                                        Opacity="0.5" />
                                                                                <TextBlock
                                                                                        x:Name="StatusText"
                                                                                        Margin="8,0,0,0"
                                                                                        VerticalAlignment="Center"
                                                                                        Text="Pending" />
                                                                        </StackPanel>
                                                                        <DataTemplate.Triggers>
                                                                                <DataTrigger Binding="{Binding processed_by_ai}" Value="1">
                                                                                        <Setter TargetName="StatusIcon" Property="Kind" Value="Brain" />
                                                                                        <Setter TargetName="StatusIcon" Property="Foreground" Value="Orange" />
                                                                                        <Setter TargetName="StatusIcon" Property="Opacity" Value="1" />
                                                                                        <Setter TargetName="StatusText" Property="Text" Value="Analyzing..." />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding processed_by_ai}" Value="2">
                                                                                        <Setter TargetName="StatusIcon" Property="Kind" Value="CheckCircle" />
                                                                                        <Setter TargetName="StatusIcon" Property="Foreground" Value="Green" />
                                                                                        <Setter TargetName="StatusIcon" Property="Opacity" Value="1" />
                                                                                        <Setter TargetName="StatusText" Property="Text" Value="Ready" />
                                                                                </DataTrigger>
                                                                        </DataTemplate.Triggers>
                                                                </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn
                                                        Width="200"
                                                        Binding="{Binding created_at}"
                                                        Header="DATE INDUCTED" />
                                        </DataGrid.Columns>
                                </DataGrid>
                        </Grid>
                </materialDesign:Card>
        </Grid>
</UserControl>
