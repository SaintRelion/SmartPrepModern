<UserControl
    x:Class="Components.QuestionPreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="750"
    Height="650"
    Background="White"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="brdFormatGuide"
            Grid.Row="0"
            Padding="25,20"
            Background="#FFF9DB"
            BorderBrush="#FFE58F"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="24"
                            Height="24"
                            VerticalAlignment="Center"
                            Foreground="#856404"
                            Kind="InformationOutline" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Black"
                            Foreground="#856404"
                            Text="QUESTIONNAIRE FORMAT" />
                    </StackPanel>
                    <TextBlock
                        Margin="34,5,0,0"
                        FontSize="12"
                        Foreground="#856404"
                        Opacity="0.8"
                        Text="Ensure the extracted items below strictly follow the required structure:"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Padding="15,10"
                    Background="#856404"
                    CornerRadius="8"
                    Opacity="0.9">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="10"
                            FontWeight="Black"
                            Foreground="White"
                            Opacity="0.7"
                            Text="EXPECTED FORMAT:" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="White"
                            Text="1. Question text goes here" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="White"
                            Text="A. First Choice" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="White"
                            Text="B. Second Choice" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#FFD700"
                            Text="Answer: A" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer
            Grid.Row="1"
            Padding="15"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icQuestions">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="20,15"
                            BorderBrush="#F1F2F6"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Black"
                                    Opacity="0.3"
                                    Text="{Binding id, StringFormat='{}{0}.'}" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        Margin="0,0,0,10"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="{Binding question_text}"
                                        TextWrapping="Wrap" />

                                    <ItemsControl Margin="0,0,0,10" ItemsSource="{Binding choices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2" Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="25"
                                                        FontWeight="Bold"
                                                        Text="{Binding Key, StringFormat='{}{0}. '}" />
                                                    <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="Black"
                                            Foreground="#2E7D32"
                                            Text="Answer: " />
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="Black"
                                            Foreground="#2E7D32"
                                            Text="{Binding correct_answer}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="20"
            Background="#F8F9FA">
            <Grid>
                <TextBlock
                    x:Name="txtItemCount"
                    VerticalAlignment="Center"
                    FontWeight="Black"
                    Opacity="0.5"
                    Text="0 ITEMS TOTAL" />
                <Button
                    HorizontalAlignment="Right"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                    Content="CLOSE"
                    Style="{StaticResource MaterialDesignFlatButton}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
