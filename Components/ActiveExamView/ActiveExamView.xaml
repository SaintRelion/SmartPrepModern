<UserControl
    x:Class="Components.ActiveExamView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid x:Name="pnlActiveExam">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="24" Background="#1A1A1A">
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock
                        x:Name="txtActiveExamTitle"
                        Background="Transparent"
                        FontSize="24"
                        FontWeight="Black"
                        Foreground="White"
                        MouseDown="txtActiveExamTitle_MouseDown"
                        Text="EXAMINATION TITLE" />
                    <TextBlock
                        x:Name="txtActiveExamCategory"
                        FontSize="12"
                        Foreground="#888"
                        Text="ATTEMPT 1 OF 3" />
                </StackPanel>

                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="btnExit_Click"
                    Foreground="#FF5252"
                    Style="{StaticResource MaterialDesignFlatButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon VerticalAlignment="Center" Kind="ExitToApp" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="EXIT SESSION" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="icQuestions" Margin="32">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,16"
                                Padding="20"
                                Background="White"
                                CornerRadius="8">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,15"
                                        FontSize="16"
                                        FontWeight="Medium"
                                        Text="{Binding question_text}"
                                        TextWrapping="Wrap" />

                                    <StackPanel>
                                        <RadioButton
                                            Margin="0,5"
                                            Checked="Option_Checked"
                                            Content="{Binding option_a}"
                                            GroupName="{Binding id}"
                                            Tag="A" />

                                        <RadioButton
                                            Margin="0,5"
                                            Checked="Option_Checked"
                                            Content="{Binding option_b}"
                                            GroupName="{Binding id}"
                                            Tag="B" />

                                        <RadioButton
                                            Margin="0,5"
                                            Checked="Option_Checked"
                                            Content="{Binding option_c}"
                                            GroupName="{Binding id}"
                                            Tag="C" />

                                        <RadioButton
                                            Margin="0,5"
                                            Checked="Option_Checked"
                                            Content="{Binding option_d}"
                                            GroupName="{Binding id}"
                                            Tag="D" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid x:Name="pnlReadOnly" Visibility="Collapsed">
                <Border Background="Black" Opacity="0.05" />
                <Border
                    Padding="10"
                    VerticalAlignment="Top"
                    Background="#FF5252">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <materialDesign:PackIcon
                            VerticalAlignment="Center"
                            Foreground="White"
                            Kind="AlertDecagram" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontWeight="Black"
                            Foreground="White"
                            Text="READ-ONLY MODE: ATTEMPTS EXHAUSTED" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Border
                x:Name="pnlSubmitLoading"
                Panel.ZIndex="1000"
                Background="White"
                Opacity="0.7"
                Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}" />
                    <TextBlock
                        Margin="0,10"
                        HorizontalAlignment="Center"
                        FontWeight="Bold"
                        Text="VALIDATING AND SUBMITTING..." />
                </StackPanel>
            </Border>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="32,24"
            Background="White"
            BorderBrush="#DDD"
            BorderThickness="0,1,0,0">
            <Button
                x:Name="btnSubmit"
                Height="54"
                Background="#1A1A1A"
                Content="FINALIZE AND SUBMIT"
                Foreground="White"
                Style="{StaticResource MaterialDesignRaisedButton}" />
        </Border>
    </Grid>
</UserControl>
