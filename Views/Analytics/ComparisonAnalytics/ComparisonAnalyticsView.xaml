<UserControl
    x:Class="Views.Analytics.ComparisonAnalyticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:SmartPrepModern.Components"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid x:Name="LayoutRoot" Background="#F5F5F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition x:Name="colReviewee" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <components:ExamSelectorView
            x:Name="ctrlExams"
            Grid.Column="0"
            ExamSelected="HandleExamChange" />

        <components:RevieweeSelectorView
            x:Name="ctrlReviewees"
            Grid.Column="1"
            RevieweeSelected="HandleUserChange"
            Visibility="Collapsed" />

        <Border Grid.Column="2" Padding="30">
            <StackPanel>
                <Button
                    Margin="0,0,0,10"
                    HorizontalAlignment="Left"
                    Click="ResetToGlobal_Click">
                    <Button.Style>
                        <Style BasedOn="{StaticResource MaterialDesignFlatButton}" TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=colReviewee, Path=Width.Value}" Value="280">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            VerticalAlignment="Center"
                            Foreground="#2196F3"
                            Kind="ArrowLeft" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="10"
                            FontWeight="Black"
                            Foreground="#2196F3"
                            Text="BACK TO GLOBAL OVERVIEW" />
                    </StackPanel>
                </Button>

                <components:GrowthTrendView
                    x:Name="ctrlGrowthChart"
                    Height="450"
                    VerticalAlignment="Top" />
            </StackPanel>
        </Border>

        <Border
            x:Name="pnlForensicContainer"
            Grid.ColumnSpan="3"
            Panel.ZIndex="2000"
            Background="#AA000000"
            Visibility="Collapsed">

            <components:QuestionForensicsView
                x:Name="ctrlForensics"
                Margin="60"
                RequestClose="HandleForensicClose" />
        </Border>

        <Border
            x:Name="pnlLoading"
            Grid.ColumnSpan="3"
            Panel.ZIndex="1000"
            Background="White"
            IsHitTestVisible="False"
            Opacity="0.8"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar
                    Width="48"
                    Height="48"
                    IsIndeterminate="True"
                    Style="{StaticResource MaterialDesignCircularProgressBar}" />
                <TextBlock
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    FontWeight="Black"
                    Opacity="0.6"
                    Text="PROCESSING ANALYTICS..." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
