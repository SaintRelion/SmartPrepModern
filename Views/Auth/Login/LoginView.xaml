<UserControl
    x:Class="Views.Auth.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Background="#121212">

    <Grid>
        <StackPanel
            Margin="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Top">
            <Button
                x:Name="btnExit"
                Width="40"
                Height="40"
                Padding="0"
                Click="Exit_Click"
                Foreground="White"
                Opacity="0.5"
                Style="{StaticResource MaterialDesignFlatButton}">
                <materialDesign:PackIcon
                    Width="26"
                    Height="26"
                    Kind="Close" />
            </Button>
        </StackPanel>

        <materialDesign:Card
            Width="380"
            Padding="32"
            VerticalAlignment="Center"
            materialDesign:ElevationAssist.Elevation="Dp6"
            UniformCornerRadius="2">
            <StackPanel>
                <materialDesign:PackIcon
                    Width="48"
                    Height="48"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    Foreground="#B71C1C"
                    Kind="ShieldAccount" />

                <TextBlock
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    FontStretch="Expanded"
                    FontWeight="Black"
                    Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                    Text="SECURE LOGIN" />

                <TextBlock
                    Margin="0,0,0,32"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Opacity="0.5"
                    Text="SmartPrep Management System" />

                <TextBox
                    x:Name="txtUsername"
                    Margin="0,0,0,16"
                    materialDesign:HintAssist.Hint="Badge Number / Username"
                    materialDesign:TextFieldAssist.HasClearButton="True"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                <PasswordBox
                    x:Name="txtPassword"
                    Margin="0,0,0,32"
                    materialDesign:HintAssist.Hint="Access Key"
                    Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" />

                <Button
                    x:Name="btnLogin"
                    Height="50"
                    Background="#B71C1C"
                    BorderBrush="#B71C1C"
                    Click="Login_Click"
                    Content="AUTHORIZE ACCESS"
                    FontWeight="Bold" />

                <TextBlock
                    x:Name="lblStatus"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#B71C1C" />

                <Button
                    Margin="0,16,0,0"
                    Click="ForgotPassword_Click"
                    Content="Forgot Access Key?"
                    FontSize="11"
                    FontWeight="Bold"
                    Foreground="#B71C1C"
                    Opacity="0.8"
                    Style="{StaticResource MaterialDesignFlatButton}" />

                <Button
                    Margin="0,4,0,0"
                    Click="ShowSignup_Click"
                    Content="Request New Credentials"
                    Foreground="#666"
                    Style="{StaticResource MaterialDesignFlatButton}" />
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
