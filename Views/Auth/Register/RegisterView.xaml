<UserControl
    x:Class="Views.Auth.RegisterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Background="#121212">
        <materialDesign:Card
            MinWidth="380"
            MaxWidth="450"
            Margin="16"
            Padding="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            materialDesign:ElevationAssist.Elevation="Dp6"
            UniformCornerRadius="2">

            <ScrollViewer materialDesign:ScrollViewerAssist.IsAutoHideEnabled="True" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <materialDesign:PackIcon
                        Width="48"
                        Height="48"
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        Foreground="#B71C1C"
                        Kind="AccountPlus" />

                    <TextBlock
                        Margin="0,0,0,24"
                        HorizontalAlignment="Center"
                        FontWeight="Black"
                        Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                        Text="PERSONNEL ENLISTMENT"
                        TextAlignment="Center" />

                    <TextBox
                        x:Name="txtRegUsername"
                        Margin="0,0,0,16"
                        materialDesign:HintAssist.Hint="Desired Username"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                    <TextBox
                        x:Name="txtRegEmail"
                        Margin="0,0,0,16"
                        materialDesign:HintAssist.Hint="Official Email Address"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                    <PasswordBox
                        x:Name="txtRegPassword"
                        Margin="0,0,0,16"
                        materialDesign:HintAssist.Hint="Secure Access Key"
                        Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" />

                    <ComboBox
                        x:Name="cmbRole"
                        Margin="0,0,0,32"
                        materialDesign:HintAssist.Hint="Assigned Role / Clearance"
                        Style="{StaticResource MaterialDesignFloatingHintComboBox}">
                        <ComboBoxItem Content="Reviewee" IsSelected="True" />
                        <ComboBoxItem Content="ReviewDirector" />
                        <ComboBoxItem Content="Admin" />
                    </ComboBox>

                    <Button
                        x:Name="btnRegister"
                        Height="50"
                        Background="#B71C1C"
                        BorderBrush="#B71C1C"
                        Click="Register_Click"
                        Content="COMPLETE ENLISTMENT"
                        FontWeight="Bold" />

                    <TextBlock
                        x:Name="lblRegStatus"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#B71C1C"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <Button
                        Margin="0,8,0,0"
                        Click="BackToLogin_Click"
                        Content="Return to Security Terminal"
                        Foreground="#666"
                        Style="{StaticResource MaterialDesignFlatButton}" />
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>
    </Grid>
</UserControl>
