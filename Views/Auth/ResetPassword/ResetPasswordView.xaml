<UserControl
    x:Class="Views.Auth.ResetPasswordView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Background="#121212">

    <Grid>
        <materialDesign:Card
            Width="380"
            Padding="32"
            VerticalAlignment="Center"
            materialDesign:ElevationAssist.Elevation="Dp6"
            UniformCornerRadius="2">
            <StackPanel>
                <materialDesign:PackIcon
                    Width="48"
                    Height="48"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    Foreground="#B71C1C"
                    Kind="KeyChange" />

                <TextBlock
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    FontWeight="Black"
                    Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                    Text="CREDENTIAL RECOVERY" />
                <TextBlock
                    Margin="0,0,0,24"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    Opacity="0.5"
                    Text="Authorization token will be dispatched to your registered email identifier."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <StackPanel x:Name="pnlRequest" Visibility="Visible">
                    <TextBox
                        x:Name="txtResetEmail"
                        materialDesign:HintAssist.Hint="Email Identifier"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                    <Button
                        x:Name="btnRequestToken"
                        Height="45"
                        Margin="0,24,0,0"
                        Background="#1A1A1A"
                        Click="RequestToken_Click"
                        Content="REQUEST RESET TOKEN"
                        FontWeight="Bold" />
                </StackPanel>

                <StackPanel x:Name="pnlVerify" Visibility="Collapsed">
                    <TextBox
                        x:Name="txtToken"
                        materialDesign:HintAssist.Hint="Reset Token"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                    <PasswordBox
                        x:Name="txtNewPassword"
                        Margin="0,16,0,0"
                        materialDesign:HintAssist.Hint="New Access Key"
                        Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" />
                    <Button
                        x:Name="btnConfirmReset"
                        Height="45"
                        Margin="0,24,0,0"
                        Background="#B71C1C"
                        BorderBrush="#B71C1C"
                        Click="ConfirmReset_Click"
                        Content="AUTHORIZE NEW KEY"
                        FontWeight="Bold" />
                </StackPanel>

                <TextBlock
                    x:Name="lblResetStatus"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#B71C1C"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <Button
                    Margin="0,16,0,0"
                    Click="BackToLogin_Click"
                    Content="Return to Login Terminal"
                    Foreground="#666"
                    Style="{StaticResource MaterialDesignFlatButton}" />
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
