<UserControl
    x:Class="Components.GrowthTrendView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Border
        Padding="24"
        Background="White"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="15"
                Opacity="0.05"
                ShadowDepth="1" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock
                    x:Name="txtTrendLabel"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="Black"
                    Opacity="0.4"
                    Text="PERFORMANCE TREND" />

                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="Gray"
                        Kind="CursorDefaultClick" />
                    <ComboBox
                        x:Name="cmbClickAction"
                        Width="170"
                        Padding="8,4"
                        FontSize="11"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}">
                        <ComboBoxItem Content="Fast Basic Scorecard" IsSelected="True" />
                        <ComboBoxItem Content="Deep AI Analysis" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <lvc:CartesianChart
                x:Name="chartGrowth"
                Grid.Row="1"
                DataClick="chartGrowth_DataClick"
                Hoverable="True"
                LegendLocation="None">

                <lvc:CartesianChart.AxisX>
                    <lvc:Axis
                        x:Name="axisX"
                        Title="Timeline"
                        LabelsRotation="-35">
                        <lvc:Axis.Separator>
                            <lvc:Separator IsEnabled="False" Step="1" />
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisX>

                <lvc:CartesianChart.AxisY>
                    <lvc:Axis
                        Title="Accuracy (%)"
                        MaxValue="100"
                        MinValue="0">
                        <lvc:Axis.Sections>
                            <lvc:AxisSection
                                Label="TARGET (75%)"
                                Stroke="#FF5722"
                                StrokeDashArray="5"
                                StrokeThickness="2"
                                Value="75" />
                        </lvc:Axis.Sections>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
        </Grid>
    </Border>
</UserControl>
