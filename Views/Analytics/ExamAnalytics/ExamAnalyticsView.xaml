<UserControl
    x:Class="Views.Analytics.ExamAnalyticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Background="{DynamicResource MaterialDesignPaper}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="#F8F8F8"
            BorderBrush="#DDD"
            BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="#1A1A1A">
                    <TextBlock
                        Margin="12,16"
                        FontSize="11"
                        FontWeight="Black"
                        Foreground="White"
                        Text="EXAMINATION LOGS" />
                </Border>

                <StackPanel Grid.Row="1" Background="#EEE">
                    <ComboBox
                        x:Name="cmbFocusType"
                        Background="White"
                        BorderThickness="0"
                        SelectionChanged="FilterExams_Local">
                        <ComboBox.Padding>12,12</ComboBox.Padding>
                        <ComboBoxItem Content="All Focus Types" IsSelected="True" />
                        <ComboBoxItem Content="Comprehensive" />
                        <ComboBoxItem Content="Weak Areas" />
                    </ComboBox>
                    <ComboBox
                        x:Name="cmbSearchDiff"
                        BorderThickness="0,1,0,0"
                        SelectionChanged="FilterExams_Api">
                        <ComboBox.Padding>12,12</ComboBox.Padding>
                        <ComboBoxItem Content="All Difficulties" IsSelected="True" />
                        <ComboBoxItem Content="Easy" />
                        <ComboBoxItem Content="Medium" />
                        <ComboBoxItem Content="Hard" />
                    </ComboBox>
                </StackPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="lstExams">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Background="#E0E0E0">
                                        <TextBlock
                                            Margin="12,4"
                                            FontSize="10"
                                            FontWeight="Black"
                                            Opacity="0.8"
                                            Text="{Binding exam_date}" />
                                    </Border>

                                    <ListBox
                                        HorizontalContentAlignment="Stretch"
                                        BorderThickness="0"
                                        ItemsSource="{Binding exams}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        SelectionChanged="ExamSelection_Changed">
                                        <ListBox.ItemContainerStyle>
                                            <Style BasedOn="{StaticResource MaterialDesignListBoxItem}" TargetType="ListBoxItem">
                                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                <Setter Property="BorderBrush" Value="#DDD" />
                                                <Setter Property="Margin" Value="0" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#1A1A1A" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock
                                                                FontSize="13"
                                                                FontWeight="Bold"
                                                                Text="{Binding focus}" />
                                                            <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    Opacity="0.5"
                                                                    Text="{Binding difficulty}" />
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    Opacity="0.3"
                                                                    Text=" • " />

                                                                <materialDesign:PackIcon
                                                                    Width="12"
                                                                    Height="12"
                                                                    Margin="0,0,2,0"
                                                                    VerticalAlignment="Center"
                                                                    Kind="AccountGroup"
                                                                    Opacity="0.5" />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontSize="10"
                                                                    Opacity="0.5"
                                                                    Text="{Binding reviewee_count}" />
                                                                <TextBlock
                                                                    Margin="2,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="9"
                                                                    Opacity="0.4"
                                                                    Text=" REVIEWEE(S)" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            FontSize="10"
                                                            Opacity="0.5"
                                                            Text="{Binding created_at}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            Background="#EEEEEE"
            BorderBrush="#DDD"
            BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource CriminologyRed}">
                    <TextBlock
                        Margin="12,16"
                        FontSize="11"
                        FontWeight="Black"
                        Foreground="White"
                        Text="REVIEWEE LIST" />
                </Border>

                <StackPanel Grid.Row="1" Background="#E5E5E5">
                    <ComboBox
                        x:Name="cmbStatusFilter"
                        Background="Transparent"
                        BorderThickness="0"
                        SelectionChanged="StatusFilter_Changed">
                        <ComboBox.Padding>12,12</ComboBox.Padding>
                        <ComboBoxItem Content="All Results" IsSelected="True" />
                        <ComboBoxItem Content="Passing (75% All Subjects)" />
                        <ComboBoxItem Content="Failed (Any Subject Below 75%)" />
                    </ComboBox>

                    <TextBlock
                        Margin="14,0,14,10"
                        FontSize="9"
                        FontStyle="Italic"
                        Foreground="#888"
                        Text="* Note: 'Failed' status is triggered if any individual material falls below the 75% threshold, regardless of average."
                        TextWrapping="Wrap" />
                </StackPanel>

                <ListBox
                    x:Name="lstReviewees"
                    Grid.Row="2"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectionChanged="lstReviewees_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="16"
                                Background="White"
                                BorderBrush="#CCC"
                                BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="Black"
                                            Foreground="#222"
                                            Text="{Binding label}" />
                                        <TextBlock
                                            FontSize="9"
                                            Opacity="0.4"
                                            Text="SESSION PROFICIENCY" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="Black"
                                        Text="{Binding percentage, StringFormat={}{0:F1}%}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="2" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="24,32" Background="#1A1A1A">
                <StackPanel>
                    <TextBlock
                        x:Name="lblDetailHeader"
                        FontSize="10"
                        FontWeight="Black"
                        Foreground="Gray"
                        Text="DETAILED PERFORMANCE ANALYSIS" />
                    <TextBlock
                        x:Name="txtUserAvg"
                        Margin="0,4,0,0"
                        FontSize="56"
                        FontWeight="Black"
                        Foreground="White"
                        Text="0.0%" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="#F0F0F0">
                <TextBlock
                    Margin="16,10"
                    FontSize="10"
                    FontWeight="Black"
                    Foreground="#B71C1C"
                    Text="CRITICAL WEAK SUBJECTS" />
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl x:Name="lstWeakBreakdown">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="16"
                                    Background="#FFF9F9"
                                    BorderBrush="#FFE5E5"
                                    BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Foreground="#B71C1C"
                                            Text="{Binding label}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            FontWeight="Black"
                                            Opacity="0.6"
                                            Text="{Binding score}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontWeight="Black"
                                            Foreground="#B71C1C"
                                            Text="{Binding percentage, StringFormat={}{0:F0}%}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="#F0F0F0">
                        <TextBlock
                            Margin="16,10"
                            FontSize="10"
                            FontWeight="Black"
                            Foreground="#555"
                            Text="COMPREHENSIVE SUBJECT ANALYSIS" />
                    </Border>

                    <ItemsControl x:Name="lstMaterialBreakdown">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="16"
                                    BorderBrush="#EEE"
                                    BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="Medium"
                                            Text="{Binding label}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            Opacity="0.4"
                                            Text="{Binding score}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontWeight="Black"
                                            Text="{Binding percentage, StringFormat={}{0:F0}%}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
