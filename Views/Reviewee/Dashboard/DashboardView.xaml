<UserControl
    x:Class="Views.Reviewee.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Background="{DynamicResource MaterialDesignPaper}">

    <Grid>
        <Grid x:Name="pnlDashboardLayout">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2.5*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="#F8F8F8"
                BorderBrush="#DDD"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="#1A1A1A">
                        <TextBlock
                            Margin="12,16"
                            FontSize="11"
                            FontWeight="Black"
                            Foreground="White"
                            Text="MY EXAMINATION HISTORY" />
                    </Border>

                    <StackPanel Grid.Row="1" Background="#EEE">
                        <ComboBox
                            x:Name="cmbSearchDiff"
                            Background="White"
                            BorderThickness="0"
                            SelectionChanged="FilterExams_Local">
                            <ComboBox.Padding>12,12</ComboBox.Padding>
                            <ComboBoxItem Content="All Difficulties" IsSelected="True" />
                            <ComboBoxItem Content="Easy" />
                            <ComboBoxItem Content="Medium" />
                            <ComboBoxItem Content="Hard" />
                        </ComboBox>

                        <ComboBox
                            x:Name="cmbFocusType"
                            Background="White"
                            BorderThickness="0,1,0,0"
                            SelectionChanged="FilterExams_Local">
                            <ComboBox.Padding>12,12</ComboBox.Padding>
                            <ComboBoxItem Content="All Types" IsSelected="True" />
                            <ComboBoxItem Content="Comprehensive" />
                            <ComboBoxItem Content="Weak Areas" />
                        </ComboBox>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="lstExams">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Background="#E0E0E0">
                                            <TextBlock
                                                Margin="12,4"
                                                FontSize="10"
                                                FontWeight="Black"
                                                Opacity="0.8"
                                                Text="{Binding exam_date}" />
                                        </Border>
                                        <ListBox
                                            HorizontalContentAlignment="Stretch"
                                            BorderThickness="0"
                                            ItemsSource="{Binding exams}"
                                            SelectionChanged="ExamSelection_Changed">
                                            <ListBox.ItemContainerStyle>
                                                <Style BasedOn="{StaticResource MaterialDesignListBoxItem}" TargetType="ListBoxItem">
                                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                    <Setter Property="BorderBrush" Value="#DDD" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#1A1A1A" />
                                                            <Setter Property="Foreground" Value="White" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="12">
                                                        <Grid>
                                                            <StackPanel>
                                                                <TextBlock
                                                                    FontSize="13"
                                                                    FontWeight="Bold"
                                                                    Text="{Binding focus}" />
                                                                <TextBlock
                                                                    Margin="0,2,0,0"
                                                                    FontSize="10"
                                                                    Opacity="0.5"
                                                                    Text="{Binding difficulty}" />
                                                            </StackPanel>
                                                            <TextBlock
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                FontSize="10"
                                                                Opacity="0.5"
                                                                Text="{Binding created_at}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="24,32" Background="#1A1A1A">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                x:Name="lblDetailHeader"
                                FontSize="10"
                                FontWeight="Black"
                                Foreground="Gray"
                                Text="DETAILED PERFORMANCE ANALYSIS" />
                            <TextBlock
                                x:Name="txtUserAvg"
                                Margin="0,4,0,0"
                                FontSize="56"
                                FontWeight="Black"
                                Foreground="White"
                                Text="0.0%" />
                        </StackPanel>

                        <StackPanel
                            Margin="0,0,0,8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                            <TextBlock
                                Margin="0,0,0,4"
                                HorizontalAlignment="Right"
                                FontSize="10"
                                FontWeight="Black"
                                Foreground="Gray"
                                Text="OVERALL SCORE" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock
                                    x:Name="txtOverallScore"
                                    FontSize="32"
                                    FontWeight="Black"
                                    Foreground="White"
                                    Text="0" />
                                <TextBlock
                                    Margin="4,0,4,0"
                                    VerticalAlignment="Bottom"
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="Gray"
                                    Text="/" />
                                <TextBlock
                                    x:Name="txtOverallTotal"
                                    VerticalAlignment="Bottom"
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="Gray"
                                    Text="0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#F0F0F0">
                    <TextBlock
                        Margin="16,10"
                        FontSize="10"
                        FontWeight="Black"
                        Foreground="#B71C1C"
                        Text="CRITICAL WEAK SUBJECTS" />
                </Border>
                <Grid Grid.Row="2">
                    <ScrollViewer
                        x:Name="scrMainAnalytics"
                        Grid.Row="2"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl x:Name="lstWeakBreakdown">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Padding="16"
                                            Background="#FFF9F9"
                                            BorderBrush="#FFE5E5"
                                            BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="Bold"
                                                    Foreground="#B71C1C"
                                                    Text="{Binding label}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Black"
                                                    Opacity="0.6"
                                                    Text="{Binding score}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Black"
                                                    Foreground="#B71C1C"
                                                    Text="{Binding percentage, StringFormat={}{0:F0}%}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Background="#F0F0F0">
                                <TextBlock
                                    Margin="16,10"
                                    FontSize="10"
                                    FontWeight="Black"
                                    Foreground="#555"
                                    Text="COMPREHENSIVE SUBJECT ANALYSIS" />
                            </Border>

                            <ItemsControl x:Name="lstMaterialBreakdown">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Padding="16"
                                            Background="Transparent"
                                            BorderBrush="#EEE"
                                            BorderThickness="0,0,0,1"
                                            Cursor="Hand"
                                            MouseDown="MaterialCard_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Foreground="#333"
                                                    Text="{Binding label}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.6"
                                                    Text="{Binding score}" />

                                                <TextBlock
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Black"
                                                    Foreground="#1A1A1A"
                                                    Text="{Binding percentage, StringFormat={}{0:F0}%}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Border
                        x:Name="pnlNoData"
                        Background="White"
                        Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon
                                Width="64"
                                Height="64"
                                HorizontalAlignment="Center"
                                Foreground="#DDD"
                                Kind="DatabaseOff" />
                            <TextBlock
                                Margin="0,16,0,4"
                                HorizontalAlignment="Center"
                                FontSize="14"
                                FontWeight="Black"
                                Foreground="#CCC"
                                Text="NO FORENSIC DATA" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Foreground="#AAA"
                                Text="This examination has not been attempted yet." />

                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Grid
            x:Name="pnlForensicOverlay"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#CC1A1A1A"
            Visibility="Collapsed">
            <Border
                Width="650"
                MaxHeight="750"
                Padding="32"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="30"
                        Opacity="0.5"
                        ShadowDepth="0" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <TextBlock
                            x:Name="txtPopupHeader"
                            FontSize="22"
                            FontWeight="Black"
                            Text="MATERIAL FORENSIC LOG" />
                        <Border
                            Height="2"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            Background="#EEE" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="lstForensicQuestions">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,16"
                                        Padding="20"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#EEE" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding is_correct}" Value="False">
                                                        <Setter Property="Background" Value="#FFF5F5" />
                                                        <Setter Property="BorderBrush" Value="#FFCDD2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock
                                                Margin="0,0,0,12"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Text="{Binding question_text}"
                                                TextWrapping="Wrap" />

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Black"
                                                        Opacity="0.5"
                                                        Text="YOUR ANSWER: " />
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Text="{Binding student_answer}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Black"
                                                        Opacity="0.5"
                                                        Text="OFFICIAL: " />
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Foreground="#2E7D32"
                                                        Text="{Binding correct_answer}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button
                        Grid.Row="2"
                        Height="50"
                        Margin="0,24,0,0"
                        Click="CloseForensic_Click"
                        Content="DISMISS DEBRIEF"
                        FontWeight="Black"
                        Style="{StaticResource MaterialDesignFlatButton}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
