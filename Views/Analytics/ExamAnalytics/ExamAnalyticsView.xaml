<UserControl
    x:Class="Views.Analytics.ExamAnalyticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:SmartPrepModern.Components"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Background="#F5F5F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="colRepoWidth" Width="350" />
            <ColumnDefinition x:Name="colRevieweeWidth" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <components:ExamSelectorView
            x:Name="ctrlExamSelector"
            Grid.Column="0"
            ExamSelected="HandleExamSelection" />

        <components:RevieweeSelectorView
            x:Name="ctrlRevieweeSelector"
            Grid.Column="1"
            RevieweeSelected="HandleRevieweeSelection"
            Visibility="Collapsed" />

        <Border Grid.Column="2">
            <components:UniversalStatsView x:Name="ctrlStatsTerminal" />
        </Border>

        <Border
            x:Name="pnlForensicContainer"
            Grid.ColumnSpan="3"
            Panel.ZIndex="5000"
            Background="#AA000000"
            Visibility="Collapsed">
            <components:QuestionForensicsView
                x:Name="ctrlForensics"
                Margin="40"
                RequestClose="HandleForensicClose" />
        </Border>
    </Grid>
</UserControl>
