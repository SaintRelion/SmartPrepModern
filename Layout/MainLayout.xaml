<UserControl
    x:Class="Layout.MainLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Background="#FFF5F5F5">

    <UserControl.Resources>
        <SolidColorBrush x:Key="SidebarBackground" Color="#1A1A1A" />
        <SolidColorBrush x:Key="CriminologyRed" Color="#B71C1C" />
        <SolidColorBrush x:Key="AccentGold" Color="#FFD700" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource SidebarBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="10,20,10,20">
                <Button
                    x:Name="btnHamburger"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Left"
                    Click="Hamburger_Click"
                    Foreground="White"
                    Style="{StaticResource MaterialDesignFlatButton}">
                    <materialDesign:PackIcon
                        Width="24"
                        Height="24"
                        Kind="Menu" />
                </Button>
                <TextBlock
                    x:Name="txtBrand"
                    Margin="12,10,0,0"
                    FontSize="18"
                    FontStretch="Expanded"
                    FontWeight="Black"
                    Foreground="{StaticResource CriminologyRed}"
                    Text="SMART PREP" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SidebarButtons" Margin="0,10,0,0" />
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                <Separator Margin="15,0" Background="#333" />
                <Button
                    x:Name="btnLogout"
                    Height="50"
                    HorizontalContentAlignment="Left"
                    Click="Logout_Click"
                    Foreground="#FFFF5252"
                    Style="{StaticResource MaterialDesignFlatButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Margin="12,0,15,0"
                            Kind="Logout" />
                        <TextBlock
                            x:Name="txtLogout"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Logout" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <materialDesign:ColorZone
                Grid.Row="0"
                Padding="24,0"
                materialDesign:ElevationAssist.Elevation="Dp2"
                Mode="Standard">
                <Grid>
                    <TextBlock
                        x:Name="txtHeaderTitle"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontStretch="Expanded"
                        FontWeight="Bold"
                        Foreground="#777"
                        Text="ADMINISTRATIVE CONSOLE" />
                </Grid>
            </materialDesign:ColorZone>

            <materialDesign:DialogHost
                x:Name="MainDialogHost"
                Grid.Row="1"
                Identifier="MainDialogHost">
                <ContentControl
                    x:Name="MainContent"
                    Grid.Row="1"
                    Margin="20" />
            </materialDesign:DialogHost>
        </Grid>
    </Grid>
</UserControl>
