<UserControl
    x:Class="Components.UniversalStatsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Background="White">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="24,32" Background="#1A1A1A">
                    <StackPanel>
                        <Button
                            x:Name="btnBack"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Left"
                            Click="btnBack_Click"
                            Content="← BACK TO CLASS"
                            Foreground="White">
                            <Button.Style>
                                <Style BasedOn="{StaticResource MaterialDesignFlatButton}" TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAggregate}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock
                            FontSize="10"
                            FontWeight="Black"
                            Foreground="Gray"
                            Text="{Binding HeaderTitle}" />
                        <TextBlock
                            FontSize="56"
                            FontWeight="Black"
                            Foreground="White"
                            Text="{Binding PrimaryMetric}" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding SubjectMetrics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="16"
                                Background="Transparent"
                                BorderBrush="#EEE"
                                BorderThickness="0,0,0,1"
                                Cursor="Hand"
                                MouseDown="SubjectCard_Click">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="Black"
                                                Foreground="#333"
                                                Text="{Binding label}" />
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Opacity="0.5"
                                                Text="Reviewee Performance Dossier" />
                                        </StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="Black"
                                            Foreground="#2196F3"
                                            Text="{Binding percentage, StringFormat={}{0:F1}%}" />
                                    </Grid>

                                    <StackPanel Margin="0,15,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsAggregate, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock
                                            Margin="0,0,0,8"
                                            FontSize="9"
                                            FontWeight="Black"
                                            Opacity="0.4"
                                            Text="SUBJECT-SPECIFIC PROFICIENCY" />
                                        <ItemsControl ItemsSource="{Binding material_breakdown}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="140" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="35" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Opacity="0.8"
                                                            Text="{Binding label}" />
                                                        <ProgressBar
                                                            Grid.Column="1"
                                                            Height="6"
                                                            VerticalAlignment="Center"
                                                            Background="#F0F0F0"
                                                            BorderThickness="0"
                                                            Foreground="#4CAF50"
                                                            Value="{Binding percentage}" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            FontSize="9"
                                                            FontWeight="Bold"
                                                            Text="{Binding percentage, StringFormat={}{0:F0}%}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid
            x:Name="pnlForensicOverlay"
            Background="#CC1A1A1A"
            Visibility="Collapsed">
            <Border
                Width="650"
                MaxHeight="700"
                Padding="32"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        FontSize="20"
                        FontWeight="Black"
                        Text="FORENSIC DEBRIEF" />
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,15"
                        Orientation="Horizontal">
                        <RadioButton
                            x:Name="rbAll"
                            Margin="0,0,15,0"
                            Checked="Filter_Checked"
                            Content="SHOW ALL"
                            IsChecked="True" />
                        <RadioButton
                            x:Name="rbWrong"
                            Checked="Filter_Checked"
                            Content="WRONG ONLY"
                            Foreground="#B71C1C" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="2">
                        <ItemsControl x:Name="lstForensicQuestions">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,10,10"
                                        Padding="15"
                                        BorderThickness="4,1,1,1"
                                        CornerRadius="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="Green" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding is_correct}" Value="False">
                                                        <Setter Property="BorderBrush" Value="#B71C1C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock
                                                Margin="0,0,0,10"
                                                FontWeight="Bold"
                                                Text="{Binding question_text}"
                                                TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding student_answer, StringFormat='Selection: {0}'}" />
                                            <TextBlock
                                                FontWeight="Bold"
                                                Foreground="Green"
                                                Text="{Binding correct_answer, StringFormat='Correct: {0}'}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding is_correct}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border
                                                Margin="0,10,0,0"
                                                Padding="10"
                                                Background="#F9F9F9">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontStyle="Italic"
                                                    Opacity="0.7"
                                                    Text="{Binding rationale}"
                                                    TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button
                        Grid.Row="3"
                        Margin="0,20,0,0"
                        Click="CloseForensic_Click"
                        Content="DISMISS"
                        Style="{StaticResource MaterialDesignFlatButton}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
